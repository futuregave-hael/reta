---
const year = new Date().getFullYear();
---
<footer class="mt-16 bg-brand-900 text-brand-50">
  <div class="max-w-5xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-3 text-sm">
    <div>
      <div class="font-serif text-2xl mb-2">
        <span class="text-white">Re</span><span class="text-brand-400">ta</span>
      </div>
      <p class="text-brand-100/80">
        Honest dating resources for grown-ups, every shape, every city.
      </p>
    </div>
    <div>
      <h4 class="font-serif text-base mb-2">Read</h4>
      <ul class="space-y-1">
        <li><a class="text-brand-100 hover:text-white" href="/blog/">All Articles</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/blog/?cat=mature">Mature Dating</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/blog/?cat=bbw">Body-Positive Dating</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/blog/?cat=regional">Local Dating</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-serif text-base mb-2">Legal</h4>
      <ul class="space-y-1">
        <li><a class="text-brand-100 hover:text-white" href="/privacy/">Privacy Policy</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/terms/">Terms of Service</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/disclaimer/">Affiliate Disclaimer</a></li>
        <li><a class="text-brand-100 hover:text-white" href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand-700/50">
    <div class="max-w-5xl mx-auto px-4 py-4 text-xs text-brand-100/70 flex flex-wrap gap-2 items-center justify-between">
      <p>&copy; {year} Reta. All rights reserved. 18+ only.</p>
      <p>
        Reta participates in affiliate programs. We may earn a commission when you sign up through our links — at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
