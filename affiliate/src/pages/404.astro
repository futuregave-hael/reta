---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="max-w-md mx-auto px-4 py-16 text-center">
    <div class="text-5xl mb-3">🌫️</div>
    <h1 class="font-serif text-3xl mb-2">Lost in the noise</h1>
    <p class="text-brand-900/70 mb-6">That page does not exist. Try the homepage or read our latest articles.</p>
    <div class="flex gap-3 justify-center">
      <a href="/" class="btn-primary">Home</a>
      <a href="/blog/" class="btn-ghost">Articles</a>
    </div>
  </section>
</BaseLayout>
