---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Reach the Reta team.">
  <article class="prose-reta px-4 py-10">
    <h1 class="font-serif text-3xl">Contact</h1>
    <p>For tips, complaints, or partnership inquiries, email <a href="mailto:hello@example.com">hello@example.com</a>.</p>
    <p class="text-sm text-brand-900/60">Replace this placeholder with your real address (e.g., Cloudflare Email Routing or a free Zoho Mail box on your domain) before launch.</p>
  </article>
</BaseLayout>
